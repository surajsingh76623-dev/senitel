# ==============================================================================
# SENTINEL - Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# Never commit real secrets or production API keys to source control.
# ==============================================================================

# Application Profile
# Options: 'dev' (uses H2 in-memory/file with Postgres syntax), 'postgres' (uses PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database Configuration (Used when SPRING_PROFILES_ACTIVE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel_db
DB_USER=sentinel_user
DB_PASSWORD=sentinel_secret_password

# AI Investigation Provider Configuration
# Options: 'demo' (deterministic, rich sample investigations, no API key needed),
#          'openai' (calls OpenAI models e.g. gpt-4o, gpt-4o-mini),
#          'gemini' (calls Google Gemini API)
SENTINEL_AI_PROVIDER=demo
SENTINEL_AI_API_KEY=
SENTINEL_AI_MODEL=gpt-4o
SENTINEL_AI_BASE_URL=https://api.openai.com/v1

# Storage Configuration
SENTINEL_STORAGE_LOCATION=./uploads
SENTINEL_MAX_FILE_SIZE_MB=15

# Frontend Configuration (when running separately via Vite dev server)
VITE_API_BASE_URL=http://localhost:8080/api
